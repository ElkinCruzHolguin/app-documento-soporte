# Copia este archivo como .env (git lo ignora) para desarrollo local.
# En Vercel estas mismas variables van en Settings > Environment Variables.
# NUNCA subas el .env ni pegues estos valores en el código.

# Puerto HTTP local (por defecto 3000). En Vercel no se usa.
PORT=3000

# Usuario y clave para entrar a la app (autenticación básica). Obligatorios en Vercel.
# En local, si no se definen, la app solo escucha en 127.0.0.1.
APP_USUARIO=
APP_CLAVE=

# Llave para cifrar la contraseña de Saphety que se guarda en la base de datos.
# Obligatoria con Supabase. Genera una larga y aleatoria y no la cambies después
# (si cambia, hay que volver a escribir las contraseñas en Administración).
APP_SECRETO=

# Supabase (Project Settings > API). Si están definidas, la app guarda perfiles e
# historial en Supabase; si no, en archivos locales dentro de DATA_DIR.
# La service_role key da acceso total: solo en el servidor, nunca en el navegador.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Carpeta de datos locales cuando no se usa Supabase (por defecto ./data)
DATA_DIR=
